{
  "name": "Pafil - integracao GHL x CVCRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/ghl-evento",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-ghl",
      "name": "Webhook GHL",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 0],
      "webhookId": "pafil-ghl-evento"
    },
    {
      "parameters": {
        "jsCode": "// TODO: confirmar contra um payload real de webhook do GHL antes de ligar isto\n// em producao. A forma abaixo segue o formato mais comum de webhook de\n// contato/oportunidade do GoHighLevel, mas o Workflow que dispara pode variar\n// o formato. Nenhuma decisao de negocio acontece aqui: so molda o payload cru\n// no formato que integracao.fila_sync espera. Casamento de contato, dono do\n// campo e deteccao de eco ficam todos em SQL (ver sql/integracao/integracao.sql).\nconst body = $json.body ?? $json;\n\nreturn {\n  json: {\n    origem: 'ghl',\n    tipo_evento: body.type ?? 'desconhecido',\n    telefone_bruto: body.phone ?? body.contact?.phone ?? null,\n    email_bruto: body.email ?? body.contact?.email ?? null,\n    cpf_bruto: null, // GHL normalmente nao guarda CPF; ajustar se houver custom field\n    campos: {\n      id_contato_ghl: body.contactId ?? body.contact?.id ?? null,\n      tags: body.tags ?? body.contact?.tags ?? null,\n      etapa_funil_marketing: body.pipelineStageId ?? null,\n      origem_campanha: body.attributionSource ?? null,\n    },\n  },\n};\n"
      },
      "id": "normalizar-ghl",
      "name": "Normalizar evento GHL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO integracao.fila_sync (origem, tipo_evento, telefone_bruto, email_bruto, cpf_bruto, campos)\nVALUES ($1, $2, $3, $4, $5, $6::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.origem, $json.tipo_evento, $json.telefone_bruto, $json.email_bruto, $json.cpf_bruto, JSON.stringify($json.campos)] }}"
        }
      },
      "id": "gravar-fila-ghl",
      "name": "Gravar fila (GHL)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [180, 0]
    },

    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/cvcrm-evento",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-cvcrm",
      "name": "Webhook CVCRM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-260, 220],
