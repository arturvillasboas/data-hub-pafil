            {
              "id": "cond-eco",
              "leftValue": "={{ $json.eh_eco }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "eh-eco",
      "name": "Eh eco?",
      "type": "n8n-nodes-base.if",
