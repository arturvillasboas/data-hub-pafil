    },
    {
      "parameters": {
        "jsCode": "// TODO: confirmar contra um payload real de webhook do CVCRM antes de ligar\n// isto em producao (inclusive se o plano da Pafil no CVCRM realmente dispara\n// webhook de mudanca de situacao -- ver a conversa que originou este plano).\n// Os nomes de campo abaixo seguem o padrao ja visto na API CVDW para /leads.\nconst body = $json.body ?? $json;\n\nreturn {\n  json: {\n    origem: 'cvcrm',\n    tipo_evento: body.evento ?? 'desconhecido',\n    telefone_bruto: body.telefone ?? body.celular ?? null,\n    email_bruto: body.email ?? null,\n    cpf_bruto: body.cpf ?? null,\n    campos: {\n      idlead_cvcrm: body.idlead ?? body.id ?? null,\n      situacao_lead: body.situacao ?? null,\n      corretor_responsavel: body.corretor ?? null,\n      empreendimento_interesse: body.empreendimento ?? null,\n    },\n  },\n};\n"
      },
      "id": "normalizar-cvcrm",
      "name": "Normalizar evento CVCRM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-40, 220]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO integracao.fila_sync (origem, tipo_evento, telefone_bruto, email_bruto, cpf_bruto, campos)\nVALUES ($1, $2, $3, $4, $5, $6::jsonb)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [$json.origem, $json.tipo_evento, $json.telefone_bruto, $json.email_bruto, $json.cpf_bruto, JSON.stringify($json.campos)] }}"
        }
      },
      "id": "gravar-fila-cvcrm",
      "name": "Gravar fila (CVCRM)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [180, 220]
    },

