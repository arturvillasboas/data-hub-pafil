    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $json.id_contato_ghl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.campos_permitidos) }}",
        "options": { "timeout": 30000 }
      },
      "id": "enviar-ghl",
      "name": "Enviar GHL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 620],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "TODO: confirmar o formato exato do body na API v2 do GHL (Private Integration da sub-account)."
    },
    {
      "parameters": {
        "jsCode": "// Recebe a saida de sucesso ou erro de qualquer um dos dois HTTP Request (CVCRM\n// ou GHL). O contexto da linha da fila (fila_sync_id, contato_id, hash, campos\n// enviados) nao sobrevive a chamada HTTP, entao volta a ser lido do no anterior\n// ao envio, igual ao padrao ja usado em automacao_reporting/workflow_n8n.json.\nconst origem = $('Canal destino').item.json;\nconst deuErro = Boolean($json.error);\n\nreturn {\n  json: {\n    fila_sync_id: origem.fila_sync_id,\n    contato_id: origem.contato_id,\n    destino: origem.destino,\n    campos_permitidos: origem.campos_permitidos,\n    hash_evento: origem.hash_evento,\n    status: deuErro ? 'erro' : 'enviado',\n    detalhe: deuErro ? String($json.error?.message ?? 'erro desconhecido').slice(0, 1000) : null,\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
      "id": "rotular-despacho",
      "name": "Rotular despacho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1060, 540]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT integracao.marcar_fila_processada($1, $2, $3);",
        "options": {
          "queryReplacement": "={{ [$json.fila_sync_id, $json.status === 'enviado' ? 'processado' : 'erro', $json.detalhe] }}"
        }
      },
      "id": "marcar-processada",
      "name": "Marcar processada",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1280, 540]
