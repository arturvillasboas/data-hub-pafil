        "query": "SELECT integracao.registrar_envio($1, $2, $3, $4::jsonb, $5, $6, $7);",
        "options": {
          "queryReplacement": "={{ [$json.fila_sync_id, $json.contato_id, $json.destino, JSON.stringify($json.campos_permitidos), $json.hash_evento, $json.status, $json.detalhe] }}"
        }
      },
      "id": "registrar-envio-integracao",
      "name": "Registrar envio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1500, 540]
