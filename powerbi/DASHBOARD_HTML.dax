// =============================================================================
// Visuais do dashboard em HTML/CSS — medidas para o visual "HTML Content".
// Complementa ESTEIRA_HTML.dax. Paleta Pafil: navy #003254 · verde #00c36b.
//
// Dependências:
//   - Medidas [VGV Bruto], [QTD Bruto] (MEDIDAS_GOLD.dax) e [Meta VGV] (metas).
//   - fato_reservas[regional]; dim_empreendimento[empreendimento_conformado];
//     dim_calendario[trimestre]; dim_metas_empreendimentos relacionada a
//     dim_calendario e dim_empreendimento (senão [Meta VGV] vem em branco).
// =============================================================================


// ---- 1) VGV por Regional (barras horizontais) -------------------------------
VGV Regional HTML =
VAR _max = MAXX ( VALUES ( fato_reservas[regional] ), [VGV Bruto] )
VAR _rows =
    CONCATENATEX (
        VALUES ( fato_reservas[regional] ),
        VAR _r   = fato_reservas[regional]
        VAR _v   = [VGV Bruto]
        VAR _pct = FORMAT ( DIVIDE ( _v, _max ), "0%" )
        RETURN
            "<div class='reg'><span class='n'>" & IF ( ISBLANK ( _r ), "s/ reg", _r ) & "</span>"
            & "<span class='t'><span class='f' style='width:" & _pct & "'></span></span>"
            & "<span class='val'>R$ " & FORMAT ( _v/1000000, "0.0" ) & " Mi</span></div>",
        "", [VGV Bruto], DESC
    )
RETURN
"<style>.rg{font-family:'Segoe UI',Arial,sans-serif}.rg .reg{display:grid;grid-template-columns:46px 1fr 70px;align-items:center;gap:10px;padding:6px 0}"
& ".rg .n{font-size:12.5px;font-weight:700;color:#16242f}.rg .t{height:16px;background:#eef2f6;border-radius:5px;overflow:hidden}"
& ".rg .f{height:100%;background:#0a4a73;border-radius:5px}.rg .val{font-size:12.5px;font-weight:700;color:#003254;text-align:right}</style>"
& "<div class='rg'>" & _rows & "</div>"


// ---- 2) Atingimento da Meta (medidor / gauge SVG) ---------------------------
Atingimento Gauge HTML =
VAR _real  = [VGV Bruto]
VAR _meta  = [Meta VGV]
VAR _falta = _meta - _real
VAR _pct   = DIVIDE ( _real, _meta )
VAR _len   = 166.5                              // comprimento do semicírculo (raio 53)
VAR _off   = _len * ( 1 - MIN ( _pct, 1 ) )
RETURN
"<style>.gz{font-family:'Segoe UI',Arial,sans-serif;text-align:center;font-size:32px;min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center}"   /* font-size = 1 botão de tamanho; o resto centraliza vertical no fundo */
& ".gz svg{width:7em;height:auto;display:block;margin:0 auto}"
& ".gz .pct{font-size:1.5em;font-weight:800;color:#00c36b;margin-top:-.6em}"
& ".gz .leg{display:flex;gap:.7em;justify-content:center;margin-top:.4em}.gz .k{font-size:.5em;color:#6b7c8c;font-weight:600}"
& ".gz .x{font-size:.72em;font-weight:800;color:#003254}.gz .x.r{color:#e2574c}</style>"
& "<div class='gz'><svg viewBox='0 0 130 72'>"
& "<path d='M 12 64 A 53 53 0 0 1 118 64' fill='none' stroke='#eef2f6' stroke-width='14' stroke-linecap='round'/>"
& "<path d='M 12 64 A 53 53 0 0 1 118 64' fill='none' stroke='#00c36b' stroke-width='14' stroke-linecap='round' stroke-dasharray='"
& _len & "' stroke-dashoffset='" & FORMAT ( _off, "0.0" ) & "'/></svg>"
& "<div class='pct'>" & FORMAT ( _pct, "0.0%" ) & "</div><div class='leg'>"
& "<div><div class='k'>Realizado</div><div class='x'>R$ " & FORMAT ( _real/1000000, "0.0" ) & " Mi</div></div>"
& "<div><div class='k'>Meta</div><div class='x'>R$ " & FORMAT ( _meta/1000000, "0.0" ) & " Mi</div></div>"
& "<div><div class='k'>Faltam</div><div class='x r'>R$ " & FORMAT ( _falta/1000000, "0.0" ) & " Mi</div></div>"
& "</div></div>"


// ---- 3) Meta × Realizado por Empreendimento (top 8, barra de progresso) ------
Meta Realizado Empreend HTML =
VAR _top = TOPN ( 8, VALUES ( dim_empreendimento[empreendimento_conformado] ), [VGV Bruto], DESC )
VAR _rows =
    CONCATENATEX (
        _top,
        VAR _e    = dim_empreendimento[empreendimento_conformado]
        VAR _real = [VGV Bruto]
        VAR _meta = [Meta VGV]
        VAR _pct  = DIVIDE ( _real, _meta )
        RETURN
            "<div class='mr'><span class='e'>" & _e & "<div class='sub'>R$ "
            & FORMAT ( _real/1000000, "0.0" ) & " / " & FORMAT ( _meta/1000000, "0.0" ) & " Mi</div></span>"
            & "<span class='t'><span class='f' style='width:" & FORMAT ( MIN ( _pct, 1 ), "0%" ) & "'></span></span>"
            & "<span class='pc'>" & FORMAT ( _pct, "0%" ) & "</span></div>",
        "", [VGV Bruto], DESC
    )
RETURN
"<style>.me{font-family:'Segoe UI',Arial,sans-serif}.me .mr{display:grid;grid-template-columns:140px 1fr 40px;align-items:center;gap:10px;padding:5px 0}"
& ".me .e{font-size:12px;font-weight:600;color:#16242f}.me .sub{font-size:10.5px;color:#6b7c8c}.me .t{height:15px;background:#eef2f6;border-radius:4px;overflow:hidden}"
& ".me .f{height:100%;background:#00c36b;border-radius:4px}.me .pc{font-size:12px;font-weight:800;color:#003254;text-align:right}</style>"
& "<div class='me'>" & _rows & "</div>"


// ---- 4) Meta × Realizado por Trimestre (barras agrupadas) -------------------
Meta Realizado Trimestre HTML =
VAR _maxV = MAXX ( VALUES ( dim_calendario[trimestre] ), MAX ( [VGV Bruto], [Meta VGV] ) )
VAR _bars =
    CONCATENATEX (
        VALUES ( dim_calendario[trimestre] ),
        VAR _q    = dim_calendario[trimestre]
        VAR _real = [VGV Bruto]
        VAR _meta = [Meta VGV]
        VAR _hm   = FORMAT ( DIVIDE ( _meta, _maxV ) * 120, "0" )
        VAR _hr   = FORMAT ( DIVIDE ( _real, _maxV ) * 120, "0" )
        RETURN
            "<div class='col'><div class='grp'>"
            & "<div class='bar meta' style='height:" & _hm & "px'>" & FORMAT ( _meta/1000000, "0.0" ) & "</div>"
            & "<div class='bar real' style='height:" & _hr & "px'>" & FORMAT ( _real/1000000, "0.0" ) & "</div>"
            & "</div><div class='lab'>" & _q & "</div></div>",
        "", dim_calendario[trimestre], ASC
    )
RETURN
"<style>.tr{font-family:'Segoe UI',Arial,sans-serif}.tr .tri{display:flex;gap:26px;align-items:flex-end;justify-content:center;height:150px}"
& ".tr .grp{display:flex;gap:8px;align-items:flex-end}.tr .bar{width:34px;border-radius:5px 5px 0 0;color:#fff;font-size:10.5px;font-weight:700;text-align:center;padding-top:4px}"
& ".tr .meta{background:#c3ced8;color:#003254}.tr .real{background:#003254}.tr .lab{text-align:center;font-size:12px;font-weight:700;margin-top:6px}"
& ".tr .leg2{display:flex;gap:14px;justify-content:center;margin-top:8px;font-size:11px;color:#6b7c8c}.tr .dot{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:4px}</style>"
& "<div class='tr'><div class='tri'>" & _bars & "</div>"
& "<div class='leg2'><span><span class='dot' style='background:#c3ced8'></span>Meta</span><span><span class='dot' style='background:#003254'></span>Realizado</span> · R$ Mi</div></div>"
