# Copie para .env e preencha com os valores reais (NUNCA versionar o .env).
# Ver ONBOARDING.md para onde conseguir cada valor.

# --- API CVCRM / CVDW --------------------------------------------------------
CVCRM_SUBDOMINIO=pafil
CVCRM_EMAIL=seu-email@pafil.com.br
CVCRM_TOKEN=solicitar-token-no-cvcrm
CVCRM_HEADER_EMAIL=email
CVCRM_HEADER_TOKEN=token

CVDW_MAX_REQ_POR_MINUTO=18
CVDW_REGISTROS_POR_PAGINA=500
CVDW_TIMEOUT=60
CVDW_BUFFER_INCREMENTAL_HORAS=24

# --- PostgreSQL ---------------------------------------------------------------
# Dev local: instância user-space na 5433 (ver ONBOARDING.md).
PG_HOST=localhost
PG_PORT=5433
PG_DB=pafil_dw
PG_USER=postgres
PG_PASSWORD=defina-uma-senha-local
PG_SSLMODE=disable
BRONZE_SCHEMA=bronze

# Produção (EC2 da empresa) — o banco NUNCA é exposto à internet. O acesso do
# analista é por túnel (SSM port forwarding ou SSH -L), que termina em localhost.
# Runbook completo: infra/README.md. Para apontar este .env para a produção,
# abra o túnel na porta local 5433 e troque só o usuário/senha:
#   PG_USER=pafil_app      # dono do banco: ingestão + DDL das camadas
#   PG_USER=pafil_bi       # somente leitura: Power BI / conferência
#   PG_PASSWORD=<gerada na instância, em /root/pafil_credenciais.txt>
# Atenção: com o túnel na 5433, o Postgres LOCAL de dev precisa estar parado
# (pg.ps1 stop) — senão a porta está ocupada e você não percebe em qual banco está.
# Confira sempre: psql -h localhost -p 5433 -c "select inet_server_addr()"

# --- De-para de gerentes (fonte autoritativa) -------------------------------
# xlsx do SharePoint COMERCIAL, espelhado localmente pelo OneDrive. Usado como
# default de popular_seeds.py --gerentes; se ausente, a dpara_gerentes NÃO é
# recarregada (evita cair no JSON legado sujo). Caminho local por máquina.
DEPARA_GERENTES_XLSX=C:\caminho\para\OneDrive\...\depara_gerentes.xlsx

# Planilha oficial de fechamento (fonte das classificações manuais por proposta).
VENDAS_CONSOLIDADAS_XLSM=C:\caminho\para\OneDrive\...\Vendas Consolidadas.xlsm

# Pasta de de-paras versionada (SharePoint/OneDrive) que o Power BI (BI V3 CVDW) lê.
DEPARA_DIR=C:\caminho\para\OneDrive\...\BI V3 CVDW\depara

# Headcount de corretores (fonte autoritativa de Gerente/Supervisor por corretor).
# Aba "Base Pafil": Nome, Imobiliaria, House, Gerente, Supervisor, Ativo/Inativo.
HEADCOUNT_CORRETORES_XLSX=C:\caminho\para\OneDrive\...\Base Corretores Pafil.xlsx

# De-paras de LEAD vivos (aba "Apoio" de Base de Leads.xlsm).
DEPARA_LEADS_XLSM=C:\caminho\para\OneDrive\...\Base de Leads.xlsm

# Etapa do pré-cadastro (DP-05, funil de crédito) — aba "Apoio" do Base - Crédito.xlsm.
ETAPA_PRECADASTRO_XLSM=C:\caminho\para\OneDrive\...\Base - Crédito.xlsm

# Extra manual de crédito (export "Relatório Web" do CVCRM).
PRECADASTRO_CREDITO_XLSX=C:\caminho\para\OneDrive\...\relatorios_precadastro.xlsx

# --- Task 6.4: preço/estoque, metas e viabilidade (BI de Preço + Empreendimento x Meta) ---
# Nenhuma vem da API CVDW — planejamento/input manual da gestão (R5 do REGRAS_NEGOCIO.md).

# Matriz de preço/estoque por unidade (abas Matriz_*). A empresa mantém DUAS (R22):
#   legado    -> Preço\Apoio\Apoio - BI de Preço.xlsm   (a que alimenta o PBIX "BI Preço")
#   bi_matriz -> BI V.2\BI Matriz\base_precos.xlsm      (a usada pela pipeline até a task 6.4)
# Desde 12/ago/2026 (task 6.5) o padrão é a do LEGADO, pra o relatório novo bater com os
# números que a gestão já conhece. ESTRUTURA_PRECOS_FONTE aceita 'legado' ou 'bi_matriz';
# se omitida, é deduzida do nome do arquivo.
ESTRUTURA_PRECOS_XLSM=C:\caminho\para\OneDrive\...\Preço\Apoio\Apoio - BI de Preço.xlsm
ESTRUTURA_PRECOS_FONTE=legado

# Metas/forecast mensais por empreendimento (Meta.xlsx, aba base_meta, tabela meta_2).
METAS_EMPREENDIMENTOS_XLSX=C:\caminho\para\OneDrive\...\BI V.2\BI Matriz\Meta.xlsx

# Parâmetros de margem por empreendimento (d_para empreendimentos.xlsx, aba viabil_padrão).
VIABILIDADE_XLSX=C:\caminho\para\OneDrive\...\BI V.2\BI Matriz\Empreendimentos\d_para empreendimentos.xlsx

# Detalhe financeiro de distrato (multa/pago/devolução/parcelas — não vem da API).
DISTRATOS_2025_XLSX=C:\caminho\para\OneDrive\...\BI V.2\BI Matriz\relatorio_distratos.xlsx
