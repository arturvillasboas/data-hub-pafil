# O repositório é editado no Windows (core.autocrlf=true) mas a pasta infra/ roda
# em Linux. Um script que chega na EC2 com CRLF falha com o erro mais enigmático
# possível: "/usr/bin/env: 'bash\r': No such file or directory". Fixar LF aqui é
# barato e evita perder meia hora depurando isso no meio do provisionamento.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
infra/**        text eol=lf

# SQL também roda no servidor (psql -f).
*.sql           text eol=lf

# Binários: nunca normalizar.
*.xlsx          binary
*.xlsm          binary
*.pbix          binary
*.pbids         binary
*.png           binary
*.pdf           binary
